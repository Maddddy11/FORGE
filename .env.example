# API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Security
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_AUDIENCE=imam-lite
JWT_ISSUER=imam-lite-api
JWT_EXPIRES_MINUTES=60

# Data stores
DATABASE_URL=postgresql+psycopg://imam:imam@postgres:5432/imam
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OBJECT_STORAGE_URL=http://minio:9000
OBJECT_STORAGE_BUCKET=imam-lite-docs

# LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional static demo tokens (dev only)
DEMO_OPERATOR_TOKEN=
DEMO_APPROVER_TOKEN=
DEMO_ADMIN_TOKEN=
